# libmimalloc-sys 0.1.49 as published (mimalloc 3.3), plus two rune-desktop patches:
# 1. Small (64 KiB) pages commit on demand in 16 KiB steps, as medium and large pages already do with
#    `mi_option_page_commit_on_demand`. Measured in OpenCode: mimalloc's committed bytes at Home
#    57.8 MB to 46.2 MB, after ten tabs closed back to Home 101.5 MB to 75.4 MB; launch and frame times unchanged.
# 2. Linux: default `MI_DEFAULT_ALLOW_THP=0` and apply `madvise(MADV_NOHUGEPAGE)` per-VMA in `unix_mmap`
#    instead of process-wide `prctl(PR_SET_THP_DISABLE, 1)` (which inherits into child shells/agents; Android
#    keeps upstream `prctl`). Prevents Fedora/Debian `THP=always` from promoting sparse 64 KiB slices in
#    mimalloc's 1 GiB arena to 2 MiB huge pages (~46 MiB less anon RSS on Linux Home, ~43-53 MiB on sessions).
diff --git a/c_src/mimalloc/v3/include/mimalloc/types.h b/vendor/libmimalloc-sys/c_src/mimalloc/v3/include/mimalloc/types.h
index 31fdace9..dc0db9cc 100644
--- a/c_src/mimalloc/v3/include/mimalloc/types.h
+++ b/vendor/libmimalloc-sys/c_src/mimalloc/v3/include/mimalloc/types.h
@@ -209,7 +209,7 @@ terms of the MIT license. A copy of the license can be found in the file
 #define MI_MAX_ALLOC_SIZE        PTRDIFF_MAX
 
 // Minimal commit for a page on-demand commit (should be >= OS page size)
-#define MI_PAGE_MIN_COMMIT_SIZE  MI_ARENA_SLICE_SIZE
+#define MI_PAGE_MIN_COMMIT_SIZE  (16*1024)   // rune-desktop: small (64 KiB) pages commit on demand too
 
 
 // ------------------------------------------------------
diff --git a/c_src/mimalloc/v3/src/arena.c b/vendor/libmimalloc-sys/c_src/mimalloc/v3/src/arena.c
index a5686d55..eb59a0ce 100644
--- a/c_src/mimalloc/v3/src/arena.c
+++ b/vendor/libmimalloc-sys/c_src/mimalloc/v3/src/arena.c
@@ -960,7 +960,7 @@ static mi_page_t* mi_arenas_page_regular_alloc(mi_theap_t* theap, size_t slice_c
 
   // 2. find a free block, potentially allocating a new arena
   const long commit_on_demand = mi_option_get(mi_option_page_commit_on_demand);
-  const bool commit = (slice_count <= mi_slice_count_of_size(MI_PAGE_MIN_COMMIT_SIZE) ||  // always commit small pages
+  const bool commit = (mi_size_of_slices(slice_count) <= MI_PAGE_MIN_COMMIT_SIZE ||  // always commit pages no larger than a commit step
                        (commit_on_demand == 2 && _mi_os_has_overcommit()) || (commit_on_demand == 0));
   page = mi_arenas_page_alloc_fresh(theap, slice_count, block_size, 1, commit);
   if (page == NULL) return NULL;
diff --git a/build.rs b/vendor/libmimalloc-sys/build.rs
index 0f3fcda9..7f9bfcb7 100644
--- a/build.rs
+++ b/vendor/libmimalloc-sys/build.rs
@@ -96,6 +96,13 @@ fn main() {
         }
     }
 
+    // rune-desktop: default THP off for mimalloc's 1 GiB arena on Linux so sparse 64 KiB
+    // slices do not pin 2 MiB transparent huge pages on distros with THP=always (Fedora, Debian).
+    // Still overridable at runtime with MIMALLOC_ALLOW_THP=1.
+    if target_os == "linux" {
+        build.define("MI_DEFAULT_ALLOW_THP", "0");
+    }
+
     if (target_os == "linux" || target_os == "android")
         && env::var_os("CARGO_FEATURE_NO_THP").is_some()
     {
diff --git a/c_src/mimalloc/v3/src/prim/unix/prim.c b/vendor/libmimalloc-sys/c_src/mimalloc/v3/src/prim/unix/prim.c
index bec22c0b..af6b02a8 100644
--- a/c_src/mimalloc/v3/src/prim/unix/prim.c
+++ b/vendor/libmimalloc-sys/c_src/mimalloc/v3/src/prim/unix/prim.c
@@ -219,16 +219,20 @@ void _mi_prim_mem_init( mi_os_mem_config_t* config )
   config->has_virtual_reserve = true; // todo: check if this true for NetBSD?  (for anonymous mmap with PROT_NONE)
   config->has_transparent_huge_pages = unix_detect_thp();
 
-  // disable transparent huge pages for this process?
-  #if (defined(__linux__) || defined(__ANDROID__)) && defined(PR_GET_THP_DISABLE)
+  // disable transparent huge pages for mimalloc mappings?
+  // rune-desktop: on desktop Linux, mark THP disabled in config without calling
+  // prctl(PR_SET_THP_DISABLE, 1), which is inherited across fork/exec into user terminals
+  // and child processes. Instead, unix_mmap applies MADV_NOHUGEPAGE per-VMA to mimalloc's
+  // own mappings. Android keeps upstream's prctl behavior unchanged.
+  #if defined(__linux__) || defined(__ANDROID__)
   if (!mi_option_is_enabled(mi_option_allow_thp)) // disable THP if requested through an option
   {
     config->has_transparent_huge_pages = false;
+    #if defined(__ANDROID__) && defined(PR_GET_THP_DISABLE)
     if (prctl(PR_GET_THP_DISABLE, 0, 0, 0, 0) == 0) {   // -1 on error, 1 if already disabled
-      // Most likely since distros often come with always/madvise settings.
-      // Disabling only for mimalloc process rather than touching system wide settings
       (void)prctl(PR_SET_THP_DISABLE, 1, 0, 0, 0);
     }
+    #endif
   }
   #endif
 }
@@ -409,6 +413,13 @@ static void* unix_mmap(void* addr, size_t size, size_t try_alignment, int protec
   if (p == NULL) {
     *is_large = false;
     p = unix_mmap_prim_aligned(addr, size, try_alignment, protect_flags, flags, fd);
+    #if (defined(__linux__) || defined(__ANDROID__)) && defined(MADV_NOHUGEPAGE)
+    if (p != NULL && !mi_option_is_enabled(mi_option_allow_thp)) {
+      // rune-desktop: opt mimalloc's arena/OS VMAs out of 2 MiB THP promotion per-VMA so
+      // THP=always distros (Fedora, Debian) don't bloat sparse 64 KiB slices to 2 MiB.
+      (void)unix_madvise(p, size, MADV_NOHUGEPAGE);
+    }
+    #endif
     #if !defined(MI_NO_THP)
     if (p != NULL && allow_large && mi_option_is_enabled(mi_option_allow_thp) && _mi_os_canuse_large_page(size, try_alignment)) {
       #if defined(MADV_HUGEPAGE)
